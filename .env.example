# Copiá este archivo a .env y cambiá los valores. El .env NO se sube al repositorio.

# Contraseña del usuario sa de SQL Server (mínimo 8 caracteres, con mayúsculas, minúsculas y números)
MSSQL_SA_PASSWORD=Cambiar_Esta_Clave_2026

# Clave para firmar los JWT: 32 caracteres o más, al azar
JWT_CLAVE=cambiar-por-una-clave-larga-y-aleatoria-de-32-o-mas

# Puertos en tu máquina
API_PUERTO_HOST=8080
SQL_PUERTO_HOST=14330

# true = crea usuarios demo (admin@demo.local / vendedor@demo.local, clave demo1234) y datos de ejemplo
CARGAR_DATOS_DEMO=true
